# Copy to backend/.env and fill in real values. backend/.env is git-ignored.
# NEVER commit real secrets to this file — it is tracked.

APP_NAME=PlantDoc API
# Set to false in production. With DEBUG=false the app refuses to start while
# SECRET_KEY is still the placeholder below.
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit origins in production. Credentials are only enabled when this is not
# the "*" wildcard, because browsers reject wildcard + credentials.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---------------------------------------------------------------
# Defaults to SQLite at backend/plantdoc.db when unset.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/plantdoc

# --- Supabase (optional server-side integration) -----------------------------
# The service-role key bypasses row-level security. Keep it server-side only
# and never bundle it into the Flutter app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Model ------------------------------------------------------------------
MODEL_PATH=../model/plant_best_model.keras
CLASS_NAMES_PATH=../Resources/class_names.json
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MODEL_INPUT_SIZE=224
MODEL_VERSION=mobilenetv2-20c-v1
