# Supabase (auth) — same project as your Supabase dashboard
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Plant disease ML API (FastAPI on cloud or local dev)
# For release APK: use your public HTTPS URL (not 127.0.0.1)
API_BASE_URL=https://your-plant-api.example.com

# Local USB dev (with adb reverse tcp:8000 tcp:8000):
# API_BASE_URL=http://127.0.0.1:8000

# Local Wi‑Fi dev (PC IP on same network):
# API_BASE_URL=http://192.168.1.42:8000
